{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "kitchen",
  "description": "Kitchen display window. Only the ticket board: no sales, no settings, no sign-in.",
  "windows": ["kds"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-app-info",
    "allow-list-kitchen-tickets",
    "allow-bump-kitchen-ticket",
    "allow-set-kitchen-item-done"
  ]
}
