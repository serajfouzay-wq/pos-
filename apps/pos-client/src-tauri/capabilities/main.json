{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main till window. Grants only the commands the till UI needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-verify-license",
    "allow-get-activation-request",
    "allow-activate-license",
    "allow-session-status",
    "allow-list-login-users",
    "allow-bootstrap-owner",
    "allow-login",
    "allow-logout",
    "allow-list-users",
    "allow-create-user",
    "allow-get-products",
    "allow-get-categories",
    "allow-save-product",
    "allow-load-sample-catalog",
    "allow-current-shift",
    "allow-open-shift",
    "allow-close-shift",
    "allow-quote-transaction",
    "allow-create-transaction",
    "allow-print-receipt",
    "allow-kick-cash-drawer",
    "allow-printer-status",
    "allow-list-printers",
    "allow-get-printer-settings",
    "allow-save-printer-settings",
    "allow-test-printer",
    "allow-sync-to-cloud",
    "allow-sync-status",
    "allow-get-menu",
    "allow-save-modifier-group",
    "allow-delete-modifier-group",
    "allow-set-product-modifier-groups",
    "allow-save-combo",
    "allow-delete-combo",
    "allow-save-dining-table",
    "allow-delete-dining-table",
    "allow-list-open-orders",
    "allow-open-order",
    "allow-update-open-order",
    "allow-split-order-line",
    "allow-fire-course",
    "allow-cancel-open-order",
    "allow-pay-open-order",
    "allow-adjust-stock",
    "allow-print-product-labels"
  ]
}
